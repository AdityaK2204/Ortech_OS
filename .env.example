# ---------------------------------------------------------------------------
# Google Maps (browser key) — see SUPABASE_SETUP.md sibling notes.
# Create at Google Cloud Console → Credentials, enable Maps JavaScript API.
# Restart `npm run dev` after editing this file.
# ---------------------------------------------------------------------------
VITE_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Supabase — from your project's Settings → API.
# Public (safe to ship in the browser; RLS protects the data):
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Service role key — SERVER ONLY, used exclusively by `npm run db:seed`.
# NEVER expose this in the frontend / commit it. Leave blank until seeding.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: password given to every seeded demo account (default: ortech123)
SEED_PASSWORD=
